# Cheia API Google Gemini (opțional pentru modul demo, necesară pentru generări live Gemini AI)
# Obține o cheie gratuită din https://aistudio.google.com/apikey
GEMINI_API_KEY=cheia_ta_aici

# Modelul Gemini utilizat pe backend (implicit: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Portul serverului Express (implicit: 3001)
PORT=3001
